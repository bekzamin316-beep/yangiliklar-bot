# ============================================================
# Telegram sozlamalar
# ============================================================
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_ID=-100XXXXXXXXXX
ADMIN_IDS=1234567890

# ============================================================
# Database
# ============================================================
DB_TYPE=postgres
DATABASE_URL=postgresql+asyncpg://cnbot:cnbot_pass@localhost:5432/cnbot_db

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI Provider (OpenRouter - bepul modellar bilan)
# ============================================================
AI_PROVIDER=openrouter
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Rotation uchun bepul modellar (quota tugasa fallback)
AI_MODELS=openai/gpt-oss-120b:free,openai/gpt-oss-20b:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free
AI_ROTATE_EVERY=5
# Qat'iy kunlik limit: har bir model uchun kuniga maksimal so'rov
AI_MODEL_DAILY_LIMIT=50
AI_DAILY_LIMIT_ENABLED=true
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODELS=openai/gpt-oss-120b:free,openai/gpt-oss-20b:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free

# Muqobil: DashScope Qwen
# AI_PROVIDER=dashscope
# AI_MODEL=qwen-plus
# DASHSCOPE_API_KEY=YOUR_DASHSCOPE_KEY_HERE
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Backup AI provider
AI_BACKUP_PROVIDER=
AI_BACKUP_API_KEY=

# ============================================================
# RSS Sources (comma-separated URLs)
# ============================================================
RSS_SOURCES=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://announcements.binance.com/en/feed,https://blog.bybit.com/feed/

# ============================================================
# External APIs
# ============================================================
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=

# ============================================================
# Scheduler
# ============================================================
NEWS_CHECK_INTERVAL=300
DIGEST_HOUR=23
DIGEST_MINUTE=0
DIGEST_TIMEZONE=Asia/Tashkent

# ============================================================
# General
# ============================================================
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
IMPORTANCE_THRESHOLD=50
MAX_NEWS_PER_RUN=20
