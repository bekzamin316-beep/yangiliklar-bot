# ============================================================
# Telegram sozlamalar
# ============================================================
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_ID=-100XXXXXXXXXX
ADMIN_IDS=1234567890

# Kanal xabarlarini o'qish uchun (Telethon) — digest manba kanallari
# API kalitlari: https://my.telegram.org → API development tools
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# StringSession — bir marta terminalda generatsiya qilinadi (quyidagi skript bilan)
TELEGRAM_SESSION_STRING=
# Digest uchun o'qiladigan manba kanallar (vergul bilan ajratilgan)
DIGEST_SOURCE_CHANNELS=

# ============================================================
# Database
# ============================================================
DB_TYPE=postgres
DATABASE_URL=postgresql+asyncpg://cnbot:cnbot_pass@localhost:5432/cnbot_db

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI Provider (DashScope Qwen — Singapur/international endpoint)
# ============================================================
AI_PROVIDER=dashscope
AI_MODEL=qwen-plus
# Rotation uchun modellar (quota tugasa navbatma-navbat fallback)
AI_MODELS=qwen3.5-122b-a10b,qwen3.7-plus,qwen3-max,qwen-max,qwen-plus,qwen-turbo
AI_ROTATE_EVERY=5
# Qat'iy kunlik limit: har bir model uchun kuniga maksimal so'rov
AI_MODEL_DAILY_LIMIT=50
AI_DAILY_LIMIT_ENABLED=true
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_KEY_HERE
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Muqobil: OpenRouter bepul modellar
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# Backup AI provider
AI_BACKUP_PROVIDER=
AI_BACKUP_API_KEY=

# ============================================================
# RSS Sources (comma-separated URLs)
# ============================================================
RSS_SOURCES=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://announcements.binance.com/en/feed,https://blog.bybit.com/feed/

# ============================================================
# External APIs
# ============================================================
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=

# ============================================================
# Scheduler
# ============================================================
NEWS_CHECK_INTERVAL=300
# PUBLISH_MODE:
#   digest  = to'planadi, kuniga 4 marta Telegraph digest chiqadi (08:00/12:00/18:00/22:00)
#   instant = har bir yangilik to'planganda zudlik bilan kanalga chiqadi
PUBLISH_MODE=digest
DIGEST_SCHEDULE_TIMES=08:00,12:00,18:00,22:00
DIGEST_TIMEZONE=Asia/Tashkent

# ============================================================
# Weekly economic calendar
# ============================================================
ECONOMIC_CALENDAR_ENABLED=true
CALENDAR_POST_DAY=sunday
CALENDAR_POST_TIME=20:00
CALENDAR_MIN_IMPACT=Medium
CALENDAR_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Weekly top token unlocks (CoinMarketCap public data-api, no key needed)
TOKEN_UNLOCKS_ENABLED=true
UNLOCKS_POST_DAY=sunday
UNLOCKS_POST_TIME=20:15
UNLOCKS_TOP_N=10

# ============================================================
# General
# ============================================================
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
IMPORTANCE_THRESHOLD=50
MAX_NEWS_PER_RUN=20
